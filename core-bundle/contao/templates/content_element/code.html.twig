{% extends '@Contao/content_element/_base.html.twig' %}
{% use '@Contao/component/_stylesheet.html.twig' %}

{% block content %}
    {% if as_editor_view %}
        {% block editor_view %}<pre>{{ code }}</pre>{% endblock %}
    {% else %}
        {% block highlighted %}
            {% set code_attributes = attrs()
                .set('id', 'code_' ~ data.id)
                .addClass('hljs')
                .addClass(language)
                .mergeWith(code_attributes|default)
            %}
            <pre><code{% block code_attributes %}{{ code_attributes }}{% endblock %}>
                {{- code -}}
            </code></pre>
        {% endblock %}
    {% endif -%}
{% endblock %}

{% block script %}
    {% add 'highlight_js' to head %}
        <script src="{{ asset('highlight.js', 'contao_core') }}" type="module"></script>
    {% endadd %}

    {% set script_attributes = attrs()
        .setIfExists('nonce', csp_nonce('script-src'))
        .mergeWith(script_attributes|default)
    %}

    <script{{ script_attributes }}>
        window.addEventListener('load', () => {
            window.hljs.highlightElement(document.getElementById('{{ 'code_' ~ data.id }}'));
        })
    </script>
{% endblock %}

{% block style %}
    {% add 'hljs_css' to stylesheets %}
        {% with {file: hljs_css|default(asset('highlight.css', 'contao_core'))} %}
            {{ block('stylesheet_component') }}
        {% endwith %}
    {% endadd %}
{% endblock %}
