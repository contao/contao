{% extends '@Contao/content_element/_base.html.twig' %}
{% use '@Contao/component/_list.html.twig' %}

{% block content %}
    {{ block('list_component') }}
{% endblock %}

{% block list_item %}
    {{- item.item|default(item)|sanitize_html('contao')|insert_tag_html -}}
    {% if item.list|default %}
        {% with {list: {items: item.list}} %}
            {{ block('list') }}
        {% endwith %}
    {% endif %}
{% endblock %}
