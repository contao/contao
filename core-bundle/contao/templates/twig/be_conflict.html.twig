{% extends '@Contao/be_main.html.twig' %}

{% set isDebug = app.debug %}
{% set isPopup = false %}
{% set backendWidth = '' %}

{% block head %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('conflict.css', 'system/themes/' ~ theme) }}" data-turbo-track="dynamic">
{% endblock %}

{% block header %}{% endblock %}

{% block container %}
    <div id="container">
        <main id="main">
            <h1>{{ h1 }}</h1>
            <p>{{ explain1 }}</p>
            <p>{{ explain2 }}</p>
            <div id="diff">{{ diff|raw }}</div>
            <div class="submit_container">
                <a href="{{ href }}" class="tl_submit">{{ button }}</a>
            </div>
        </main>
    </div>
{% endblock %}
