{% embed '@Contao/backend/template_studio/show_modal.stream.html.twig' %}
    {% trans_default_domain 'contao_template_studio' %}
    {% set dialog_attributes = attrs().addClass('template-studio--snapshot-compare') %}

    {% block title %}{{ 'template_studio.snapshots.compare'|trans }}{% endblock %}

    {% block content %}
        {% if diff %}
            <div class="template-studio--snapshot-diff">
                {% for line in diff|split('\n') %}
                    {% if line starts with 'diff --git ' %}
                        {% set kind = 'file' %}
                    {% elseif line starts with '@@ ' %}
                        {% set kind = 'hunk' %}
                    {% elseif line starts with '+' and not line starts with '+++' %}
                        {% set kind = 'added' %}
                    {% elseif line starts with '-' and not line starts with '---' %}
                        {% set kind = 'deleted' %}
                    {% else %}
                        {% set kind = 'context' %}
                    {% endif %}
                    <div class="line line--{{ kind }}">{{ line }}</div>
                {% endfor %}
            </div>
        {% else %}
            <p class="description">{{ 'template_studio.snapshots.no_changes'|trans }}</p>
        {% endif %}
    {% endblock %}
{% endembed %}
