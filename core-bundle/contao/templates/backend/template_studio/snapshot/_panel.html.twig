{% trans_default_domain 'contao_template_studio' %}

{% if snapshots_available %}
    <form id="template-studio--snapshot-panel" class="template-studio--snapshots" method="post" data-turbo="true" data-turbo-stream>
        <span class="current-snapshot">
            {% if current_snapshot %}
                {% set snapshot_token -%}
                    <code class="token">{{ current_snapshot.hash|slice(0, 10) }}</code>
                {%- endset %}
                {% set snapshot_date -%}
                    <time datetime="{{ current_snapshot.date }}">{{ current_snapshot.date|date(contao.datim_format) }}</time>
                {%- endset %}
                {{ 'template_studio.snapshots.current'|trans([snapshot_token, snapshot_date])|raw }}
            {% endif %}
        </span>

        <div class="snapshot-buttons">
            <button type="submit" formaction="{{ path('_contao_template_studio_snapshot.stream') }}" title="{{ 'template_studio.snapshots.create'|trans }}" aria-label="{{ 'template_studio.snapshots.create'|trans }}" data-contao--tooltips-target="tooltip">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M13.997 4a2 2 0 0 1 1.76 1.05l.486.9A2 2 0 0 0 18.003 7H20a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h1.997a2 2 0 0 0 1.759-1.048l.489-.904A2 2 0 0 1 10.004 4z"/>
                    <circle cx="12" cy="13" r="3"/>
                </svg>
            </button>

            {% if current_snapshot %}
                <button type="submit" formaction="{{ path('_contao_template_studio_snapshot_compare.stream') }}" title="{{ 'template_studio.snapshots.compare'|trans }}" aria-label="{{ 'template_studio.snapshots.compare'|trans }}" data-contao--tooltips-target="tooltip">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="5" cy="6" r="3"/>
                        <path d="M12 6h5a2 2 0 0 1 2 2v7"/>
                        <path d="m15 9-3-3 3-3"/>
                        <circle cx="19" cy="18" r="3"/>
                        <path d="M12 18H7a2 2 0 0 1-2-2V9"/>
                        <path d="m9 15 3 3-3 3"/>
                    </svg>
                </button>
                <button type="submit" formaction="{{ path('_contao_template_studio_snapshot_rollback.stream') }}" title="{{ 'template_studio.snapshots.rollback'|trans }}" aria-label="{{ 'template_studio.snapshots.rollback'|trans }}" data-contao--tooltips-target="tooltip" data-snapshot-operation="rollback">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
                        <path d="M3 3v5h5"/>
                    </svg>
                </button>
            {% endif %}
        </div>
    </form>
{% endif %}
