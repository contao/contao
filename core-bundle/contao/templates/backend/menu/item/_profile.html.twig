{% trans_default_domain 'contao_default' %}

{% set item = item
    .setChildrenAttribute('id', 'profileMenu')
    .setChildrenAttribute('data-controller', 'contao--toggle-receiver')
    .setChildrenAttribute('data-contao--toggle-receiver-active-class', 'active')
    .setChildrenAttribute('data-action', 'click@document->contao--toggle-receiver#documentClick keydown.esc@document->contao--toggle-receiver#close')
    .setChildrenAttribute('data-contao--toggle-receiver-contao--toggle-sender-outlet', '#profileButton')
%}

<button
    id="profileButton"
    type="button"
    title="{{ 'MSC.showProfile'|trans }}"
    data-controller="contao--toggle-sender"
    data-action="contao--toggle-sender#toggle:prevent"
    data-contao--toggle-sender-active-title-value="{{ 'MSC.hideProfile'|trans }}"
    data-contao--toggle-sender-inactive-title-value="{{ 'MSC.showProfile'|trans }}"
    data-contao--toggle-sender-contao--toggle-receiver-outlet="#profileMenu"
    data-contao--tooltips-target="tooltip"
>{{ item.label }}</button>
