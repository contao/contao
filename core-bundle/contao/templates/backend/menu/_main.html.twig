{% extends '@KnpMenu/menu.html.twig' %}

{% trans_default_domain 'contao_default' %}

{% block item %}
    {% set is_group = item.extra('contao_backend_menu_is_group', item.level == 1 and item.hasChildren) %}
    {% set is_collapsed = false %}

    {% if is_group %}
        {% set backend_modules = app.session.getBag('contao_backend').get('backend_modules')|default({}) %}
        {% set is_collapsed = backend_modules[item.name]|default(1) == 0 %}

        {# Store the collapsed state on the item, no need to set it on the link again #}
        {% set item = item
            .setExtra('contao_backend_menu_is_collapsed', is_collapsed)
            .setChildrenAttribute('id', item.childrenAttribute('id')|default(item.name))
        %}
    {% endif %}

    {% set item_attributes = attrs()
        .addClass(item.attribute('class')|default)
        .addClass('collapsed', is_collapsed)
        .addClass('has-children', not is_group and item.hasChildren)
    %}
    {% set item = item.setAttribute('class', item_attributes['class']|default) %}

    {{ parent() }}
{% endblock %}

{% block spanElement %}
    {% if item.extra('contao_backend_menu_is_group', item.level == 1 and item.hasChildren) %}
        {{ block('linkElement') }}
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block linkElement %}
    {% set is_group = item.extra('contao_backend_menu_is_group', item.level == 1 and item.hasChildren) %}
    {% set is_collapsed = item.extra('contao_backend_menu_is_collapsed', false) %}
    {% set group = is_group ? item.name : null %}
    {% set icon = item.extra('contao_backend_menu_icon') %}

    {% set translation_domain = item.extra('translation_domain', 'messages') %}
    {% set title = item.extra('title', item.label) %}
    {% set title = translation_domain is same as(false) ? title : title|trans(item.extra('translation_params', {}), translation_domain) %}

    {% set link_attributes = attrs()
        .set('title', is_group ? (is_collapsed ? 'MSC.expandNode' : 'MSC.collapseNode')|trans : title)
        .addClass(is_group ? 'group-' ~ group : 'navigation')
        .set('data-contao--tooltips-target', 'tooltip')
        .set('data-action', 'contao--toggle-navigation#toggle:prevent', is_group)
        .set('data-contao--toggle-navigation-category-param', group, is_group)
        .set('data-turbo-prefetch', 'false', is_group)
        .set('aria-controls', item.childrenAttribute('id'), is_group)
        .set('aria-expanded', is_collapsed ? 'false' : 'true', is_group)
        .mergeWith(item.linkAttributes)
    %}

    <a href="{{ item.uri ?: path('contao_backend', {do: app.request.query.get('do'), mtg: group}) }}"{{ link_attributes }}>
        {%- if icon %}{{ backend_icon(icon, attributes: attrs().addClass('icon')) }}{% endif -%}
        {{- block('label') -}}
    </a>
{% endblock %}
