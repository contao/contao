{% trans_default_domain 'contao_default' %}
{% extends '@Contao/block_searchable.html.twig' %}

{% set wrapperAttributes = attrs()
    .addClass(['ce_text', 'content-text'])
    .mergeWith(wrapperAttributes|default)
%}

{% set hl = 'h1' %}

{% block content %}

    {{ text|default|sanitize_html('contao')|csp_inline_styles|encode_email|insert_tag_html }}
    <p class="more"><a href="{{ href }}" title="{{ readMore }}">{{ 'MSC.more'|trans }}<span class="invisible"> {{ headline|insert_tag_html }}</span></a></p>

{% endblock %}
