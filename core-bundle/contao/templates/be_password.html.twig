{% trans_default_domain "contao_default" -%}

<!DOCTYPE html>
<html lang="{{ app.locale|language_tag }}" data-turbo="false">
<head>

    <meta charset="{{ charset }}">
    <title>{{ 'MSC.pw_new'|trans }} | {{ host }}</title>
    <meta name="generator" content="Contao Open Source CMS">
    <meta name="viewport" content="width=device-width,initial-scale=1.0,shrink-to-fit=no">
    <meta name="referrer" content="origin">
    <meta name="turbo-visit-control" content="reload">

    <link rel="stylesheet" href="{{ asset('login.css', 'contao_core') }}">
    {{ stylesheets|default|raw }}

    <script>{{ getLocaleString.invoke()|raw }}</script>
    <script src="{{ asset('js/mootools.min.js', 'contao-components/mootools') }}"></script>
    <script src="{{ asset('backend.js', 'contao_core') }}"></script>
    <script>{{ getDateString.invoke()|raw }}</script>
    {{ javascripts|default|raw }}

</head>
<body class="be_password">

<div id="container">
    <main id="main">
        <form class="tl_login_form" method="post">
            <div class="formbody">
                <input type="hidden" name="FORM_SUBMIT" value="tl_password">
                <input type="hidden" name="REQUEST_TOKEN" value="{{ contao.request_token }}">
                <h1>{{ 'MSC.pw_new'|trans }}</h1>
                <p>{{ 'MSC.pw_change'|trans }}</p>
                {{ widget|raw }}
                <div class="submit_container">
                    <a href="{{ path('contao_backend_logout') }}" class="tl_submit">{{ 'MSC.cancelBT'|trans }}</a>
                    <button type="submit" name="login" id="login" class="tl_submit">{{ 'MSC.continue'|trans }}</button>
                </div>
            </div>
        </form>
    </main>
    {{ messages|raw }}
</div>

<script>
    window.addEvent('domready', function() {
        if (parent.frames[0] && parent.frames[0].name == 'switch') {
            parent.location.reload();
        }
        $('password').focus();
    });
</script>

</body>
</html>
