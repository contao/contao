#left {
    width: 220px;
    display: flex;
    flex-direction: column;
}

#left .version {
    margin-top: 4em;
    padding: 15px 18px;
    font-size: 0.75rem;
    line-height: 1.4;
}

#left .version,
#left .version a {
    color: var(--nav-group);
}

@media (width < 992px) {
    #left {
        visibility: hidden;
        width: 240px;
        flex-shrink: 0;
        margin-left: -240px;
        transition: transform 0.2s ease, visibility 0.2s ease;
        will-change: transform, visibility;
    }

    #left.active {
        visibility: visible;
        transform: translateX(240px);

        + #main,
        + #contao-main #main {
            transform: translateX(240px);
        }
    }
}

@media (width >= 1280px) {
    #sbtog {
        display: none;
    }
}
