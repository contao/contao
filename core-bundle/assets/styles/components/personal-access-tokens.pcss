.personal-access-tokens {
    border-top: 1px solid var(--border);

    .list_pats {
        margin: 0 15px 15px;
    }

    .pat-list {
        td.name {
            button {
                box-sizing: border-box;
                border: 0;
                text-align: left;
                margin: 0;
                background-color: transparent;
                display: flex;

                code {
                    word-break: break-word;
                }
            }

            &.tl_confirm {
                background-position: 11px center;
            }
        }

        td.tl_confirm {
            padding-left: 32px;
        }

        td.expires {
            width: 30%;

            @media (width <= 767.98px) {
                width: auto;
            }
        }

        td.actions {
            text-align: right;
            width: 50px;

            @media (width <= 767.98px) {
                width: auto;
            }

            button {
                border: 0;
                padding: 0;
                background-color: transparent;

                img {
                    vertical-align: -3px;
                }
            }
        }

        td.tl_confirm + td {
            background-color: var(--confirm-bg);
        }
    }
}
