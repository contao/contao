#tl_versions {
    margin-bottom: 0;
}

#tl_versions table {
    width: 100%;
    margin-bottom: 18px;
}

#tl_versions td:first-child {
    white-space: nowrap;
}

#tl_versions td:last-child {
    width: 32px;
    white-space: nowrap;
    text-align: right;
}

#tl_versions .pagination {
    margin-top: 18px;
    margin-bottom: 14px;
    padding: 12px;
    background: var(--table-header);
    border: 0;
    border-radius: var(--border-radius);
}

@media (width < 768px) {
    #tl_versions table tr {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));

        td,
        th {
            display: block;
            border-top: 0;
        }

        th:last-child {
            display: none;
        }

        td:first-child,
        td:nth-child(2) {
            border-top: 2px solid var(--border);
        }

        td:last-child {
            width: auto;
            grid-column: 1 / -1;
        }
    }
}
