dialog[data-controller="contao--dialog"].template-studio {
    .name_container {
        margin: 0 12px 10px;

        h3 {
            margin-bottom: 4px;
        }
    }

    input.identifier--user {
        vertical-align: baseline;
        border: 0 none;
        border-radius: var(--border-radius);
        background: var(--border);
    }

    input:invalid {
        color: var(--red) !important;
    }
}

dialog[data-controller="contao--dialog"].template-studio--snapshot-compare {
    .dialog_wrapper {
        width: min(90vw, 1200px);
        max-width: none;
    }

    .template-studio--snapshot-diff {
        max-height: 70vh;
        margin: 0;
        overflow: auto;
        background: var(--code-bg);
        color: var(--text);
        font: 0.75rem "Roboto Mono", monospace;
        line-height: 1.3;

        code {
            display: block;
            min-width: max-content;
            padding: 10px;
        }

        .hljs-comment {
            color: var(--blue);
        }

        .hljs-addition,
        .hljs-deletion {
            display: inline-block;
            min-width: 100%;
        }

        .hljs-addition {
            background: var(--diff-right);
        }

        .hljs-deletion {
            background: var(--diff-left);
        }
    }
}
