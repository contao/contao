@import "common.pcss";
@import "tree.pcss";
@import "editor-tab.pcss";
@import "operations.pcss";
@import "info.pcss";
@import "dialog.pcss";

.template-studio--snapshots {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 10px;
    margin: 0 0 0 auto;
    align-items: center;

    .current-snapshot {
        display: inline-flex;
        gap: 4px;
        align-items: baseline;
        margin-right: 6px;
        font-size: 0.8rem;
        white-space: nowrap;
    }

    .snapshot-buttons {
        display: flex;
        gap: 6px;
    }

    button {
        transition: transform 0.1s;

        &:hover {
            transform: scale(1.15);
        }
    }
}

@keyframes point-left {
    0% {
        transform: translateX(1ch);
        opacity: 0;
    }

    25% {
        transform: translateX(-1ch);
        opacity: 0.75;
    }

    100% {
        transform: translateX(-1ch);
        opacity: 0.75;
    }
}

#template-studio {
    --hover-color: var(--green);

    height: calc(100vh - 7rem);
    overflow: hidden;
    display: grid;
    grid-template-areas: "nav tabs info";
    grid-template-columns: auto 1fr min-content;
    position: relative;

    * {
        scrollbar-width: thin;
    }

    > :empty {
        display: none;
    }

    &:fullscreen {
        padding: 6px;
    }

    #template-studio--nav {
        grid-area: nav;
        border-right: 1px solid var(--border);
        overflow: hidden;
        resize: horizontal;
        min-width: 100px;
        max-width: max-content;
        display: flex;
        flex-direction: column;
    }

    #template-studio--theme-selector {
        border-bottom: 1px solid var(--border);
        padding: 6px;

        > label {
            font-size: 0.8em;
            margin-left: 4px;
            color: var(--info);
        }

        > :is(.tl_select, .tl_select_wrapper) {
            margin-top: 5px;
            margin-bottom: 3px;
        }
    }

    #template-studio--tabs {
        grid-area: tabs;
        position: relative;
        overflow-y: auto;

        .explainer {
            max-width: 60ch;
            background-color: var(--content-bg);
            padding: 12px;
            line-height: 1.3;

            h3 {
                margin-bottom: 12px;
            }

            svg {
                margin-left: 1ch;
                vertical-align: middle;
                animation: point-left 4s infinite;
            }
        }
    }

    #template-studio--info {
        grid-area: info;
        border-left: 1px solid var(--border);
        overflow-y: auto;
        min-width: 220px;

        @media (width >= 1540px) {
            min-width: 320px;
        }

        @media (width >= 1640px) {
            min-width: 420px;
        }

        .block {
            text-align: right;
        }

        .template_name {
            row-gap: 8px;

            .structure {
                flex-wrap: wrap;
                justify-content: flex-end;
            }
        }

        .badges {
            justify-content: flex-end;
        }
    }
}

#main_headline button.fullscreen {
    transition: transform 0.1s;

    &:hover {
        transform: scale(1.25);
    }
}

main > .content-top:has(> #template-studio--snapshot-panel) {
    gap: 15px 6px;
    flex-wrap: wrap;
}
