:root {
    --icon-toggle-all: url("../../icons/chevron-right.svg");
    --icon-jobs: url("../../icons/jobs.svg");
    --icon-favorite: url("../../icons/favorite.svg");
    --icon-favorite-active: url("../../icons/favorite_active.svg");
    --icon-arrow-left: url("../../icons/arrow_left.svg");
    --icon-arrow-right: url("../../icons/arrow_right.svg");
    --icon-visible: url("../../icons/visible.svg");
    --icon-invisible: url("../../icons/invisible.svg");
    --icon-loading: url("../../icons/loading.svg");
    --icon-favorites-group: url("../../icons/favorites_group.svg");
    --icon-content: url("../../icons/content.svg");
    --icon-monitor: url("../../icons/monitor.svg");
    --icon-person: url("../../icons/person.svg");
    --icon-wrench: url("../../icons/wrench.svg");
    --icon-user-profile: url("../../icons/profile.svg");
    --icon-chevron-left: url("../../icons/chevron-left.svg");
    --icon-chevron-right: url("../../icons/chevron-right.svg");
    --icon-chevron-down: url("../../icons/chevron-down.svg");
    --icon-corner-down-right: url("../../icons/corner-down-right.svg");
    --icon-close: url("../../icons/close.svg");
}

html[data-color-scheme="dark"] {
    --icon-toggle-all: url("../../icons/chevron-right--dark.svg");
    --icon-jobs: url("../../icons/jobs--dark.svg");
    --icon-favorite: url("../../icons/favorite--dark.svg");
    --icon-favorite-active: url("../../icons/favorite_active--dark.svg");
    --icon-arrow-left: url("../../icons/arrow_left--dark.svg");
    --icon-arrow-right: url("../../icons/arrow_right--dark.svg");
    --icon-visible: url("../../icons/visible--dark.svg");
    --icon-invisible: url("../../icons/invisible--dark.svg");
    --icon-loading: url("../../icons/loading--dark.svg");
    --icon-favorites-group: url("../../icons/favorites_group--dark.svg");
    --icon-content: url("../../icons/content--dark.svg");
    --icon-monitor: url("../../icons/monitor--dark.svg");
    --icon-person: url("../../icons/person--dark.svg");
    --icon-wrench: url("../../icons/wrench--dark.svg");
    --icon-user-profile: url("../../icons/profile--dark.svg");
    --icon-chevron-left: url("../../icons/chevron-left--dark.svg");
    --icon-chevron-right: url("../../icons/chevron-right--dark.svg");
    --icon-chevron-down: url("../../icons/chevron-down--dark.svg");
    --icon-corner-down-right: url("../../icons/corner-down-right--dark.svg");
    --icon-close: url("../../icons/close--dark.svg");
}
