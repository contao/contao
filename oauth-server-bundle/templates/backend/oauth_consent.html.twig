{% trans_default_domain 'contao_default' -%}

<!DOCTYPE html>
<html lang="{{ app.locale|language_tag }}" data-turbo="false">
<head>
    <meta name="turbo-visit-control" content="reload">

    {% block head %}
        <meta charset="UTF-8">
        <title>Contao | {{ app.request.host }} - Connect {{ client_name }}</title>

        {% block meta %}
            <meta name="generator" content="Contao Open Source CMS">
            <meta name="viewport" content="width=device-width,initial-scale=1.0,shrink-to-fit=no">
            <meta name="referrer" content="origin">
            <meta name="robots" content="noindex,nofollow">
        {% endblock %}

        <link rel="stylesheet" href="{{ asset('login.css', 'contao_core') }}">
        {{ stylesheets|default|raw }}

        {{ javascripts|default|raw }}
    {% endblock %}
</head>
<body{{ attrs(attributes|default).addClass('be_oauth_consent') }}>

    {% block container %}
        <div id="container">
            <main id="main">
                <h1>Connect <i>{{ client_name }}</i> with Contao?</h1>
                <p>The application will act as <strong>{{ user.username }}</strong> and can do <strong>everything</strong> this user account is allowed to do in the back end.</p>
                <p>The client <strong>{{ client_host }}</strong> will redirect you to <strong>{{ redirect_host }}</strong> after you allowed the connection.</p>
                <form class="tl_login_form" method="post">
                    <div class="formbody">
                        <input type="hidden" name="REQUEST_TOKEN" value="{{ request_token }}">
                        <input type="hidden" name="request_key" value="{{ request_key }}">
                        <div class="submit_container">
                            <button type="submit" class="tl_submit" name="decision" value="allow">Allow</button>
                        </div>
                        <div class="submit_container">
                            <button type="submit" class="tl_submit" name="decision" value="deny">Deny</button>
                        </div>
                    </div>
                </form>
            </main>
        </div>
    {% endblock %}

</body>
</html>
