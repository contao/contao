{% trans_default_domain 'contao_default' %}
{% extends '@Contao/block_searchable.html.twig' %}

{% block content %}

    {{ articles|raw }}

    {% if referer|default %}
        <!-- indexer::stop -->
        <p class="back"><a href="{{ referer }}">{{ 'MSC.goBack'|trans }}</a></p>
        <!-- indexer::continue -->
    {% endif %}

    {% if allowComments|default %}
        <div class="ce_comments block">
            <{{ hlc }}>{{ 'MSC.comments'|trans }}</{{ hlc }}>
            {{ comments|join|raw }}
            {{ pagination|default|raw }}
            <{{ hlc }}>{{ 'MSC.addComment'|trans }}</{{ hlc }}>
            {{ include('@Contao/mod_comment_form.html.twig', ignore_missing: true) }}
        </div>
    {% endif %}

{% endblock %}
